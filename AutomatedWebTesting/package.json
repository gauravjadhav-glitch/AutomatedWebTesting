  "license": "ISC",
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "dotenv": "^16.4.0",
    "image-ssim": "^0.2.0",
    "lighthouse": "^12.0.0",
    "openai": "^4.70.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.0.0",
    "yargs": "^17.7.0"
  }
}
