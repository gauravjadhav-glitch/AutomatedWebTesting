{
  "name": "automated-web-testing",
  "version": "1.0.0",
  "description": "Autonomous E-Commerce QA Agent — 5-layer architecture for comprehensive website testing",
  "main": "run-test.js",
  "scripts": {
    "test": "node run-test.js",
    "test:fast": "node run-test.js --mode=fast",
    "test:standard": "node run-test.js --mode=standard",
    "test:deep": "node run-test.js --mode=deep",
    "recheck": "node recheck-4k-bugs.js",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": ["qa", "testing", "playwright", "e-commerce", "automation"],
